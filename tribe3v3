		fovCircle.Color = K.White
		fovCircle.Filled = false
		fovCircle.Radius = Config.AimFov
		fovCircle.Position = cam.ViewportSize / 2
	end
end

local function drawHitMarker(now)
	if not hitMarker then
		hitMarker = {}
		for i = 1, 4 do
			hitMarker[i] = newDrawing("Line")
		end
	end
	local active = Config.HitMarker and now < (op.hitMarkerUntil or 0)
	local cam = camera()
	if active and cam then
		local center = cam.ViewportSize / 2
		local gap, len = 4, 8
		local offs = {
			{ Vector2.new(-gap, -gap), Vector2.new(-gap - len, -gap - len) },
			{ Vector2.new(gap, -gap), Vector2.new(gap + len, -gap - len) },
			{ Vector2.new(-gap, gap), Vector2.new(-gap - len, gap + len) },
			{ Vector2.new(gap, gap), Vector2.new(gap + len, gap + len) },
		}
		for i = 1, 4 do
			local line = hitMarker[i]
			if line then
				line.Visible = true
				line.Color = K.White
				line.Thickness = 2
				line.From = center + offs[i][1]
				line.To = center + offs[i][2]
			end
		end
	else
		for i = 1, 4 do
			if hitMarker[i] then
				hitMarker[i].Visible = false
			end
		end
	end
end

local function hideAllVisuals()
	for _, e in espSlots do
		for _, obj in e do
			if obj then
				obj.Visible = false
			end
		end
	end
	for _, line in tracerSlots do
		if line then
			line.Visible = false
		end
	end
	for _, set in skeletonSlots do
		for _, line in set do
			if line then
				line.Visible = false
			end
		end
	end
	for _, entry in trapSlots do
		if entry.label then
			entry.label.Visible = false
		end
	end
	if fovCircle then
		fovCircle.Visible = false
	end
	for i = 1, 4 do
		if hitMarker and hitMarker[i] then
			hitMarker[i].Visible = false
		end
	end
	for model, entry in chamEntries do
		pcall(function()
			entry.highlight.Enabled = false
		end)
	end
end

