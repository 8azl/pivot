local function drawPlayers()
	local cam = camera()
	local own = character()
	local origin = own and rootOf(own)
	origin = origin and origin.Position
	local espIndex, tracerIndex, skelIndex = 1, 1, 1
	if
		(Config.PlayerEsp or Config.PlayerTracers or Config.PlayerChams or Config.SkeletonEsp)
		and cam
		and origin
	then
		for _, model in Targets.list() do
			local relation = Targets.relation(model)
			local show = relation == "enemy" or (relation == "ally" and Config.EspTeammates)
			if show and isAlive(model) and model ~= own then
				local root = rootOf(model)
				local head = headOf(model) or root
				if root then
					local dist = (root.Position - origin).Magnitude
					if dist <= Config.EspMaxDistance then
						local colour = relationColour(relation)
						local okTop, top =
							pcall(cam.WorldToViewportPoint, cam, head.Position + Vector3.new(0, 2, 0))
						local okBot, bottom =
							pcall(cam.WorldToViewportPoint, cam, root.Position - Vector3.new(0, 3, 0))
						if okTop and okBot and top.Z > 0 and bottom.Z > 0 then
							local height = math.abs(bottom.Y - top.Y)
							local width = height * 0.6
							local x = (top.X + bottom.X) / 2 - width / 2
							local y = math.min(top.Y, bottom.Y)
							if Config.PlayerChams then
								local entry = chamEntries[model]
								if not entry then
									local ok, hl = pcall(Instance.new, "Highlight")
