function Core.segmentClear(cast, from, to, isTarget, passable)
	local skip = {}
	local origin = from
	for _ = 1, 8 do
		local delta = to - origin
		if delta.Magnitude < 0.05 then
			return true, false
		end
		local hit = cast(origin, delta, skip)
		if not hit then
			return true, false
		end
		if isTarget(hit.Instance) then
			return true, true
		end
		if not passable(hit.Instance) then
			return false, false
		end
		table.insert(skip, hit.Instance)
		origin = hit.Position
	end
	return false, false
end
function Core.arcClear(cast, origin, velocity, gravity, travel, isTarget, passable)
	local steps = math.clamp(math.ceil(travel / 0.04), 4, 48)
	local previous = origin
	for index = 1, steps do
		local t = travel * index / steps
		local point = origin + velocity * t - Vector3.new(0, 0.5 * gravity * t * t, 0)
		local clear, reached = Core.segmentClear(cast, previous, point, isTarget, passable)
		if not clear then
			return false
		end
		if reached then
			return true
		end
		previous = point
	end
	return true
end
