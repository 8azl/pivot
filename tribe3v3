local Core = {}
function Core.solve(origin, position, velocity, speed, gravity, grounded)
	if speed <= 0 then
		return position, 0
	end
	local travel = (position - origin).Magnitude / speed
	local point = position
	local worldGravity = Workspace.Gravity
	for _ = 1, 12 do
		local dy = if grounded
			then math.clamp(velocity.Y * travel, -1.5, 1.5)
			else math.clamp(velocity.Y * travel - 0.5 * worldGravity * travel * travel, -10, 8)
		local future = position + Vector3.new(velocity.X * travel, dy, velocity.Z * travel)
		local aim = future + Vector3.new(0, 0.5 * gravity * travel * travel, 0)
		local nextTravel = (aim - origin).Magnitude / speed
		point = aim
		if math.abs(nextTravel - travel) < 1e-4 then
			travel = nextTravel
			break
		end
		travel = nextTravel
	end
	return point, travel
end
function Core.reachable(origin, point, travel, speed)
	return travel <= 5 and (point - origin).Magnitude <= 1200 and speed > 0
end
function Core.score(mode, offset, distance, health, maxHealth)
	local fraction = math.clamp(health / math.max(maxHealth, 1), 0, 1)
	if mode == "Lowest HP" then
		return fraction * 1000 + offset * 0.01
	elseif mode == "Closest" then
		return distance + offset * 0.001
	end
	return offset + fraction * 0.001
end
function Core.spring(current, target, velocity, smoothness, dt)
	local time = 0.02 + (smoothness / 100) * 0.4
	local omega = 2 / time
	local x = omega * dt
	local decay = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local temp = (velocity + omega * change) * dt
	local newVelocity = (velocity - omega * temp) * decay
	return target + (change + temp) * decay, newVelocity
end
function Core.wrapAngle(angle)
