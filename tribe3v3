local function bindRemotes()
	if Shared.RemotesBound then
		return true
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		return false
	end
	local combatFX = remotes:FindFirstChild("CombatFX")
	local combatFXU = remotes:FindFirstChild("CombatFXU")
	local hitConfirm = remotes:FindFirstChild("HitConfirm")
	if combatFX then
		U.connect(combatFX.OnClientEvent, function(kind, data)
			onCombatFX(kind, data)
		end)
	end
	if combatFXU then
		U.connect(combatFXU.OnClientEvent, function(kind, data)
			onCombatFX(kind, data)
		end)
	end
	if hitConfirm then
		U.connect(hitConfirm.OnClientEvent, function()
			if Config.HitMarker then
				op.hitMarkerUntil = tick() + 0.18
			end
		end)
	end
	Shared.RemotesBound = true
	return combatFX ~= nil or hitConfirm ~= nil
end

local function stepReady(now)
	if not op.hooked then
		op.hooked = installHooks() == true
	end
	if not op.backstop then
		op.backstop = installRemoteBackstop() == true
	end
	if not Shared.RemotesBound then
		bindRemotes()
	end
	if now >= (op.syncAt or 0) then
		op.syncAt = now + 2.5
		if op.hooked then
			syncInputStatsWatches()
		end
	end
end

