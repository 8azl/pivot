local function syncInputStatsWatches()
	local inputStats = mod("InputStats")
	if not inputStats then
		return
	end
	local getups = (type(debug) == "table" and type(debug.getupvalues) == "function" and debug.getupvalues)
		or (type(getupvalues) == "function" and getupvalues)
	local setup = (type(debug) == "table" and type(debug.setupvalue) == "function" and debug.setupvalue)
		or (type(setupvalue) == "function" and setupvalue)
	if type(getups) ~= "function" then
		return
	end
	for _, key in { "Take", "Watch", "Caller" } do
		local orig = Shared.Originals["InputStats." .. key]
		local fn = orig or inputStats[key]
		if type(fn) == "function" then
			local ok, ups = pcall(getups, fn)
			if ok and type(ups) == "table" then
				for idx, uv in pairs(ups) do
					if type(uv) == "number" and type(setup) == "function" then
						pcall(setup, fn, idx, 0)
					elseif type(uv) == "table" and uv ~= inputStats and uv.BodyVelocity == nil then
						if #uv == 1 and type(uv[1]) == "number" then
							uv[1] = 0
						elseif type(uv[1]) == "table" and uv[1].t ~= nil and uv[1].k ~= nil then
							for _, item in ipairs(uv) do
								if type(item) == "table" and type(item.t) == "table" and item.k ~= nil then
									item.f = rawget(item.t, item.k)
								end
							end
						elseif key == "Caller" and uv[1] == nil then
							pcall(setmetatable, uv, VALID_CALLER_MT)
						end
					end
				end
			end
		end
	end
end
local function overwriteGuardFn(moduleName, target, key, fn)
	if not target or type(target[key]) ~= "function" then
