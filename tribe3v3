	local head = ctx.char and ctx.char:FindFirstChild("Head")
	local meleeEye = if head and head:IsA("BasePart") then head.Position else myPos + Vector3.new(0, 1.5, 0)
	local myVel = root.AssemblyLinearVelocity
	local hitDelay = math.clamp(handler.tuning and handler.tuning.hitDelay or 0.08, 0.04, 0.16)
	local best, bestScore = nil, math.huge
	for _, model in Targets.list() do
		if Targets.hittable(model) then
			local theirRoot = rootOf(model)
			local theirHumanoid = humanoidOf(model)
			if theirRoot and theirHumanoid then
				local theirPos = theirRoot.Position
				local offset = theirPos - myPos
				local distance = offset.Magnitude
				local predOffset = (theirPos + theirRoot.AssemblyLinearVelocity * hitDelay) - (myPos + myVel * hitDelay)
