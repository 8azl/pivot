									e.hp.Color = Color3.fromRGB(80, 230, 90)
									e.hp.Filled = true
									e.hp.Position = Vector2.new(x - 5, y + height * (1 - frac))
									e.hp.Size = Vector2.new(3, height * frac)
								end
								local armor = U.attr(model, "Armor")
								local maxArmor = U.attr(model, "MaxArmor")
								local aFrac = (
									type(armor) == "number"
									and type(maxArmor) == "number"
									and maxArmor > 0
								)
										and math.clamp(armor / maxArmor, 0, 1)
									or 0
								if e.armor then
									e.armor.Visible = Config.HealthBars and aFrac > 0
									e.armor.Color = Color3.fromRGB(230, 210, 90)
									e.armor.Filled = true
									e.armor.Position = Vector2.new(x - 9, y + height * (1 - aFrac))
									e.armor.Size = Vector2.new(3, height * aFrac)
								end
								if e.htext then
									e.htext.Visible = Config.EspHealthText and hum ~= nil
									if e.htext.Visible then
										e.htext.Text = tostring(math.floor((hum and hum.Health) or 0))
										e.htext.Color = K.White
										e.htext.Size = 12
										e.htext.Center = true
										e.htext.Outline = true
										e.htext.Position = Vector2.new(x - 5, y - 14)
									end
								end
							end
							if Config.PlayerTracers then
								local line = slot(tracerSlots, tracerIndex, function()
									return newDrawing("Line")
								end)
								tracerIndex += 1
								if line then
									line.Visible = true
									line.Color = colour
									line.Thickness = 1
									line.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
									line.To = Vector2.new((top.X + bottom.X) / 2, bottom.Y)
								end
							end
							if Config.SkeletonEsp then
								local set = slot(skeletonSlots, skelIndex, function()
									local lines = {}
									for i = 1, #BONES do
										lines[i] = newDrawing("Line")
									end
									return lines
								end)
								skelIndex += 1
								for i, bone in BONES do
									local line = set[i]
									local a = partPos(model, bone[1])
									local b = partPos(model, bone[2])
									if line then
										if a and b then
											local okA, pa = pcall(cam.WorldToViewportPoint, cam, a)
											local okB, pb = pcall(cam.WorldToViewportPoint, cam, b)
											if okA and okB and pa.Z > 0 and pb.Z > 0 then
												line.Visible = true
												line.Color = colour
												line.Thickness = 1
												line.From = Vector2.new(pa.X, pa.Y)
												line.To = Vector2.new(pb.X, pb.Y)
											else
												line.Visible = false
											end
										else
											line.Visible = false
										end
									end
								end
							end
						end
					end
				end
			end
		end
	end
	hideFrom(espSlots, espIndex, function(e)
		for _, obj in e do
			if obj then
				obj.Visible = false
			end
		end
	end)
	hideFrom(tracerSlots, tracerIndex, function(line)
		if line then
			line.Visible = false
		end
	end)
	hideFrom(skeletonSlots, skelIndex, function(set)
		for _, line in set do
			if line then
				line.Visible = false
			end
		end
	end)
	for model, entry in chamEntries do
		if not (model.Parent and Config.PlayerChams) then
			pcall(function()
				entry.highlight:Destroy()
			end)
			chamEntries[model] = nil
		end
	end
end

local function drawTraps()
	local cam = camera()
	local own = character()
	local origin = own and rootOf(own)
	origin = origin and origin.Position
	local index = 1
	if Config.TrapEsp and cam and origin then
		local ok, tagged = pcall(CollectionService.GetTagged, CollectionService, "BearTrap")
		if ok and type(tagged) == "table" then
			for _, trap in tagged do
				if typeof(trap) == "Instance" then
					local sprung = U.attr(trap, "Sprung")
					local ownerId = U.attr(trap, "OwnerUserId")
					local mine = ownerId ~= nil and ownerId == LocalPlayer.UserId
					local part = trap:IsA("BasePart") and trap or trap:FindFirstChildWhichIsA("BasePart")
					if part and not sprung and not mine then
						local okP, point = pcall(cam.WorldToViewportPoint, cam, part.Position)
						if okP and point.Z > 0 then
							local dist = (part.Position - origin).Magnitude
							if dist <= Config.EspMaxDistance then
								local entry = slot(trapSlots, index, function()
									return { label = newDrawing("Text") }
								end)
								index += 1
								if entry.label then
									entry.label.Visible = true
									entry.label.Text = "TRAP " .. tostring(math.floor(dist)) .. "m"
									entry.label.Color = Color3.fromRGB(255, 160, 60)
									entry.label.Size = 12
									entry.label.Center = true
									entry.label.Outline = true
									entry.label.Position = Vector2.new(point.X, point.Y)
								end
							end
						end
					end
				end
			end
		end
	end
	hideFrom(trapSlots, index, function(entry)
		if entry.label then
			entry.label.Visible = false
		end
	end)
end

local function drawFov()
	if not Config.ShowFov then
		if fovCircle then
			fovCircle.Visible = false
