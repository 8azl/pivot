local function onCombatFX(kind, data)
	if type(data) ~= "table" then
		return
	end
	local pos = data.position or data.origin or data.from
	local source = data.character or data.attacker or data.model
	if source and Targets.relation(modelOf(source) or source) ~= "enemy" then
		return
	end
	local own = character()
	local root = rootOf(own)
	if not root then
		return
	end
	if typeof(pos) ~= "Vector3" then
		local sr = rootOf(modelOf(source) or source)
		pos = sr and sr.Position
	end
	if typeof(pos) ~= "Vector3" then
		return
	end
	local dist = (pos - root.Position).Magnitude
	local radius = Config.BlockRadius + 10
	if kind == "Projectile" or kind == "ProjectileHit" then
		radius = Config.BlockRadius + 6
	elseif kind == "Swing" then
		radius = 14
	elseif kind == "Charge" or kind == "Heavy" or kind == "Lunge" then
		radius = 20
	end
	if dist <= radius then
		op.threatUntil = tick() + 0.35
		op.threatFrom = pos
		if Config.AutoParry then
			op.parryDue = tick() + Core.parryDelay(0.12, ping(), Config.ParryPingComp)
			op.parryUntil = op.parryDue + Core.parryHold(0.12, ping(), 0.05, Config.ParryPingComp)
			op.parryFrom = pos
		end
	end
end

local function stepAutoBlock(now)
	if not Config.AutoBlock then
		if op.blockHeld then
			dispatch("Secondary", false)
			op.blockHeld = false
		end
		return
	end
	local active = now < op.threatUntil
	if active and not op.blockHeld then
		dispatch("Secondary", true)
		op.blockHeld = true
	elseif not active and op.blockHeld then
		dispatch("Secondary", false)
		op.blockHeld = false
	end
	if active and Config.BlockFaceThreat and typeof(op.threatFrom) == "Vector3" then
		local sim = mod("Simulation")
		local root = rootOf(character())
		if sim and type(sim.SetFacing) == "function" and root then
			local flat = (op.threatFrom - root.Position) * K.Flat
			if flat.Magnitude > 0.1 then
				pcall(sim.SetFacing, math.atan2(-flat.Unit.X, -flat.Unit.Z))
			end
		end
	end
end

local function stepParry(now)
	if not Config.AutoParry or not op.parryDue then
		return
	end
	local handler = op.handler
	if now >= op.parryDue and not op.parryActive then
		op.parryActive = true
		if handler and type(handler.RaiseParry) == "function" then
			pcall(handler.RaiseParry, handler)
		else
			dispatch("Secondary", true)
		end
	end
	if op.parryActive and now >= (op.parryUntil or 0) then
		op.parryActive = false
		op.parryDue = nil
		if handler and type(handler.LowerParry) == "function" then
			pcall(handler.LowerParry, handler)
		else
			dispatch("Secondary", false)
		end
	end
end

