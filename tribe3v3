local moduleCache = {}
local moduleRetry = {}
local function mod(name)
	local cached = moduleCache[name]
	if cached then
		return cached
	end
	if tick() < (moduleRetry[name] or 0) then
		return nil
	end
	local entry = MODULES[name]
	if not entry then
		return nil
	end
	local node = entry[1]
	for part in entry[2]:gmatch("[^%.]+") do
		node = node and node:FindFirstChild(part)
	end
	if not node and name == "Ballistics" then
		local combat = mod("Combat")
		if type(combat) == "table" and type(combat.Ballistics) == "table" then
			moduleCache[name] = combat.Ballistics
			return combat.Ballistics
		end
	end
	if typeof(node) ~= "Instance" then
		moduleRetry[name] = tick() + 2
		return nil
	end
	local ok, result = pcall(require, node)
	if ok and type(result) == "table" then
		moduleCache[name] = result
		return result
	end
	moduleRetry[name] = tick() + 2
	return nil
end

local function character()
	local model = LocalPlayer.Character
