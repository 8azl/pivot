	elseif kind == "Charge" then
		local theirRoot = data.on and (data.kind == "Heavy" or data.kind == "Lunge") and enemyRoot(data.attacker)
		if theirRoot and (theirRoot.Position - root.Position).Magnitude <= 20 then
			noteThreat(theirRoot.Position, 1.2)
		end
	elseif kind == "Swing" then
		local theirRoot = enemyRoot(data.attacker)
