local function onScreen(worldPos)
	local cam = camera()
	if not cam then
		return false, nil, math.huge
	end
	local ok, point, visible = pcall(cam.WorldToViewportPoint, cam, worldPos)
	if not ok or not visible or point.Z <= 0 then
		return false, nil, math.huge
	end
	local center = cam.ViewportSize / 2
	local flat = Vector2.new(point.X - center.X, point.Y - center.Y)
	return true, flat, flat.Magnitude
end

local Ballistics = {}
function Ballistics.isGun(kind)
	return kind == "Crossbow" or kind == "Musket" or kind == "Pistol" or kind == "Blunderbuss"
end
function Ballistics.profile(kind, tuning, charge, override)
	local combat = mod("Combat")
	local speed = override
	local gravity = K.ThrowGravity
	if type(tuning) == "table" then
		if kind == "Hatchets" then
			speed = speed or K.HatchetSpeed
			gravity = 0
		elseif tuning.returns then
			speed = speed or tuning.speed or 90
			gravity = 0
		elseif combat and type(combat.DrawnShot) == "function" and (kind == "Bow" or tuning.drawTime) then
			local _ok, _dmg, drawnSpeed = pcall(combat.DrawnShot, tuning, charge or 1)
			speed = speed or drawnSpeed or tuning.speed
			gravity = tuning.gravity or K.ThrowGravity
		else
			if combat and type(combat.ShotSpeed) == "function" then
				local ok, value = pcall(combat.ShotSpeed, tuning)
				if ok and value then
					speed = speed or value
				end
			end
			speed = speed or tuning.speed or tuning.speedMax
			gravity = tuning.gravity or K.ThrowGravity
		end
	end
	return speed, gravity or 0
end
function Ballistics.velocity(model, root)
	local now = tick()
	local entry = op.velocities[model]
	local physical = root.AssemblyLinearVelocity
	if typeof(physical) ~= "Vector3" then
		physical = Vector3.zero
	end
	if not entry or entry.root ~= root then
		entry = { root = root, pos = root.Position, vel = physical, at = now }
		op.velocities[model] = entry
		return physical
	end
	local dt = now - entry.at
	if dt > 0.0001 then
		local delta = (root.Position - entry.pos) / dt
		entry.vel = entry.vel * 0.5 + delta * 0.5
		entry.pos = root.Position
		entry.at = now
	end
	return entry.vel * 0.5 + physical * 0.5
end
function Ballistics.intercept(origin, model, part, speed, gravity)
	local root = rootOf(model) or part
	local target = part.Position
	if not speed or speed <= 0 then
		return target
	end
	local vel = Ballistics.velocity(model, root)
	local factor = Config.AutoPrediction and 1 or math.clamp(Config.Prediction / 100, 0, 1.5)
	vel = vel * factor
	local predicted = target
	for _ = 1, K.SolveSteps do
		local flat = (predicted - origin) * K.Flat
		local dist = flat.Magnitude
		local travel = dist / speed
		predicted = target + vel * travel
		if gravity and gravity > 0 then
			predicted = predicted + Vector3.new(0, 0.5 * gravity * travel * travel, 0)
		end
	end
	return predicted
end

local function activeHandlerState(action, payload)
	local handler = op.handler
	if not (handler and handler.tuning) then
		return nil
	end
	local kind = handler.ctx and handler.ctx.kind
	local tuning = (action == "Hurl") and handler.tuning.throw or handler.tuning
	return {
		kind = (action == "Hurl") and "Hatchets" or kind,
		tuning = tuning,
		charge = Config.FullCharge and 1 or (tonumber(payload and payload.charge) or 1),
		shotId = tonumber(payload and payload.id),
		gun = action == "Shoot" and Ballistics.isGun(kind),
		handler = handler,
	}
end
local function silentDirection(origin)
	local shot = op.shot
	if not shot then
		local handler = op.handler
		if not (handler and handler.tuning) then
			return nil
		end
		shot = {
			kind = handler.ctx and handler.ctx.kind,
			tuning = handler.tuning,
			charge = Config.FullCharge and 1 or 1,
			gun = Ballistics.isGun(handler.ctx and handler.ctx.kind),
			handler = handler,
		}
	end
	local speed, gravity = Ballistics.profile(shot.kind, shot.tuning, shot.charge, shot.overrideSpeed)
	local best, bestScore
	for _, model in Targets.list() do
		if Targets.relation(model) == "enemy" and Targets.hittable(model) then
			local part = aimPart(model)
			if part then
				local okScreen, _, px = onScreen(part.Position)
				if okScreen and px <= Config.AimFov then
					local predicted = Ballistics.intercept(origin, model, part, speed, gravity)
					local reach = (predicted - origin).Magnitude
					if Core.reachable(reach, speed) then
						local clear = not Config.VisibleCheck
							or Sight.arcClear(origin, predicted, model, speed, gravity)
						if clear then
							local score = px
							if Config.AimPriority == "Closest" then
								score = reach
							elseif Config.AimPriority == "Lowest HP" then
								local hum = humanoidOf(model)
								score = hum and hum.Health or reach
							end
							if not bestScore or score < bestScore then
								bestScore = score
								best = predicted
							end
						end
					end
				end
			end
		end
	end
	if best then
		local dir = (best - origin)
		if dir.Magnitude > 0.001 then
			local result = dir.Unit
			if op.shot then
				op.shot.silentDir = result
			end
			return result
		end
	end
	return nil
end
local function probePass(...)
	local util = mod("Util")
	if util and type(util.Probe) == "function" then
		local ok, value = pcall(util.Probe, ...)
		if ok and value ~= nil then
			return true, value
		end
	end
	return false, nil
end
local function hook(moduleName, key, build)
	local target = mod(moduleName)
	if not target or type(target[key]) ~= "function" then
		return false
	end
	local id = moduleName .. "." .. key
	local original = Shared.Originals[id] or target[key]
	Shared.Originals[id] = original
	local replacement = build(original)
	target[key] = type(newcclosure) == "function" and newcclosure(replacement) or replacement
	table.insert(Pivot.Restore, function()
		target[key] = original
	end)
	return true
end
local function within(state, original, ...)
	local previous = op.shot
	op.shot = state
	local packed = table.pack(pcall(original, ...))
	op.shot = previous
	if not packed[1] then
		error(packed[2], 0)
	end
