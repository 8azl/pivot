									e.name.Color = K.White
									e.name.Size = 13
									e.name.Center = true
									e.name.Outline = true
									e.name.Position = Vector2.new(x + width / 2, y - 16)
								end
								if e.info then
									e.info.Visible = Config.EspInfo
									if Config.EspInfo then
