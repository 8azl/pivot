local function ping()
	local stats = mod("Util")
	if stats and type(stats.Ping) == "function" then
		local ok, value = pcall(stats.Ping)
		if ok and type(value) == "number" and value >= 0 then
			return math.min(value, 1)
		end
	end
	local ok, item = pcall(function()
		return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
	end)
	if ok and type(item) == "number" then
		return math.clamp(item / 1000, 0, 1)
	end
	return 0.05
end

local Core = {}
function Core.dirChecksum(dir)
	return dir.X * 3 + dir.Y * 5 + dir.Z * 7
end
function Core.shotPayload(action, payload, direction)
	if typeof(direction) ~= "Vector3" or direction.Magnitude < 0.001 then
		return
	end
	payload.dir = direction.Unit
	payload.q = Core.dirChecksum(payload.dir)
end
function Core.spring(current, target, velocity, smoothness, dt)
	local time = 0.02 + (smoothness / 100) * 0.4
	local omega = 2 / math.max(time, 0.0001)
	local x = omega * dt
	local decay = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
	local change = current - target
	local temp = (velocity + omega * change) * dt
	local newVel = (velocity - omega * temp) * decay
	local newPos = target + (change + temp) * decay
	return newPos, newVel
end
function Core.facing(look, origin, target, arcDeg, distance, minDistance)
	local flat = (target - origin) * K.Flat
	local mag = flat.Magnitude
	if mag < (minDistance or 0) then
		return true
	end
	if distance and mag > distance then
		return false
	end
	local flatLook = (look * K.Flat)
	if flatLook.Magnitude < 0.001 then
		return false
	end
	local dot = flatLook.Unit:Dot(flat.Unit)
	return dot >= math.cos(math.rad(arcDeg) / 2)
end
function Core.parryDelay(hitDelay, pingValue, compensate)
	local comp = compensate and (1.5 * pingValue) or 0
	return math.max(0, (hitDelay or 0.1) - comp - 0.03)
end
function Core.parryHold(hitDelay, pingValue, grace, compensate)
	local comp = compensate and (2 * pingValue) or 0
	return math.clamp((hitDelay or 0.1) + comp + (grace or 0) + 0.25, 0.25, 1.4)
end
function Core.reachable(travel, speed)
	if not speed or speed <= 0 then
		return false
	end
	return travel / speed <= K.MaxTravel and travel <= K.MaxRange
end
function Core.behind(targetRoot, offset)
	local cframe = targetRoot.CFrame
	local back = cframe.LookVector * -math.clamp(offset or 3, 1.5, 6)
	return targetRoot.Position + back
end
function Core.reacted(seenAt, now, delayMs)
	if not seenAt then
		return false
	end
	return (now - seenAt) * 1000 >= (delayMs or 0)
end

local Targets = {}
function Targets.relation(model)
