local function cameraAim(dt)
	if not (Pivot.Running and Settings.Aimbot) then
		return
	end
	if Settings.AimbotKey == "Hold Right Mouse" and not mouseHeld(Enum.UserInputType.MouseButton2) then
		return
	end
	local cameraModule = mod("Camera")
	if not cameraModule or not character() then
		return
	end
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local origin = camera.CFrame.Position
	local model, part = Targets.onScreen(origin)
	if not part then
		op.aimSpring = nil
		return
	end
	local point = part.Position
	local handler = op.handler
	if handler and handler.ctx and isRanged(handler.ctx.kind) then
		local util = mod("Util")
		local muzzle = util and okValue(util.ShotOrigin, handler.ctx.tool, "Muzzle")
		local shotFrom = typeof(muzzle) == "Vector3" and muzzle or origin
		local speed, gravity = Ballistics.profile(handler.ctx.kind, handler.tuning, handlerCharge(handler))
		point = Ballistics.intercept(shotFrom, model, part, speed, gravity)
	end
	local direction = (point - origin).Unit
	local yaw = math.atan2(-direction.X, -direction.Z)
	local pitch = math.asin(math.clamp(direction.Y, -1, 1))
	local currentYaw, currentPitch = cameraModule.GetYaw(), cameraModule.GetPitch()
	local spring = op.aimSpring
	if not spring or os.clock() - spring.at > 0.2 or spring.model ~= model then
		spring = { yawVel = 0, pitchVel = 0, model = model, seed = math.random() * 100 }
		op.aimSpring = spring
	end
	spring.at = os.clock()
	if Settings.AimSmoothness <= 0 then
		cameraModule.SetLook(yaw, pitch)
		return
	end
	if Settings.AimHumanize then
		local wobble = math.noise(spring.at * 1.3, spring.seed) * 0.004
		yaw += wobble
		pitch += math.noise(spring.seed, spring.at * 1.1) * 0.003
	end
	local deltaYaw = Core.wrapAngle(yaw - currentYaw)
	local newYaw, yawVel = Core.spring(currentYaw, currentYaw + deltaYaw, spring.yawVel, Settings.AimSmoothness, dt)
	local newPitch, pitchVel = Core.spring(currentPitch, pitch, spring.pitchVel, Settings.AimSmoothness, dt)
