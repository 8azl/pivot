	local handler = parryHandler()
	if not handler or handler.parrying or mouseHeld(Enum.UserInputType.MouseButton2) then
		return
	end
	if type(handler.ParryReady) ~= "function" or not handler:ParryReady() then
		return
	end
	local ping = networkPing()
	local delay = Core.parryDelay(hitDelay, ping, Settings.ParryPingComp)
	local hold = Core.parryHold(hitDelay, ping, handler.tuning.parry.grace)
	local function raise()
		if not (Pivot.Running and Settings.AutoParry) or op.handler ~= handler or handler.parrying then
			return
		end
		if not handler:ParryReady() then
			return
		end
		if source then
			local cameraModule = mod("Camera")
			local root = rootOf(character())
			if cameraModule and root then
				local flat = (source - root.Position) * Vector3.new(1, 0, 1)
				if flat.Magnitude > 0.5 then
					pcall(cameraModule.SetLook, math.atan2(-flat.X, -flat.Z), cameraModule.GetPitch())
				end
			end
		end
		handler:RaiseParry()
		if handler.parrying then
			Parry.lowerAt = os.clock() + hold
			Parry.handler = handler
		end
	end
	if delay > 0 then
		task.delay(delay, raise)
