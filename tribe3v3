local function scoreOf(model, part, origin, px)
	if Config.AimPriority == "Closest" or Config.AuraPriority == "Closest" then
		return (part.Position - origin).Magnitude
	end
	if Config.AimPriority == "Lowest HP" or Config.AuraPriority == "Lowest HP" then
		local hum = humanoidOf(model)
		return hum and hum.Health or px
	end
	return px
end
local function pickEnemy(origin, requireVisible)
	local best, bestPart, bestScore
	for _, model in Targets.list() do
		if Targets.relation(model) == "enemy" and Targets.hittable(model) then
			local part = aimPart(model)
			if part then
				local okScreen, _, px = onScreen(part.Position)
				if okScreen and px <= Config.AimFov then
					if (not requireVisible) or Sight.clear(origin, part.Position, model) then
						local score = scoreOf(model, part, origin, px)
						if not bestScore or score < bestScore then
							bestScore = score
							best = model
							bestPart = part
						end
					end
				end
			end
		end
	end
	return best, bestPart
end
local function pickMelee(root, facingCheck)
	local tuning = op.handler and op.handler.tuning
	local reach = (tuning and (tuning.range or (tuning.lunge and tuning.lunge.range))) or 10
	reach = reach + Config.MeleeReach + K.ReachBias
	local best, bestScore
	for _, model in Targets.list() do
		if Targets.relation(model) == "enemy" and Targets.hittable(model) then
			local tr = rootOf(model)
			if tr then
				local flat = (tr.Position - root.Position) * K.Flat
				local d = flat.Magnitude
				if d <= reach and math.abs(tr.Position.Y - root.Position.Y) < 8 then
					local ok = true
					if facingCheck then
						ok = Core.facing(root.CFrame.LookVector, root.Position, tr.Position, 160, nil, 3.2)
					end
					if
						ok
						and d >= Config.AutoSwingMinDistance
						and (d < 3.2 or Sight.clear(root.Position, tr.Position, model))
					then
						local score = Config.AuraPriority == "Lowest HP"
								and (humanoidOf(model) and humanoidOf(model).Health or d)
							or d
						if not bestScore or score < bestScore then
							bestScore = score
							best = model
						end
					end
				end
			end
		end
	end
	return best
end
local function pickTeleportTarget(root)
