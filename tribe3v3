	local state = okValue(controller.State)
	local shotId = (op.shot and tonumber(op.shot.shotId))
		or ((type(state) == "table" and tonumber(state.shotId) or 0) + 1)
	local seed = okValue(handler.Seed, handler, shotId)
	if type(seed) ~= "number" then
		return desiredDir
	end
	local aimed = if type(handler.Aimed) == "function"
		then okValue(handler.Aimed, handler) == true
		else handler.aiming == true
	local spread = aimed and (handler.tuning.spreadAim or 0) or (handler.tuning.spreadHip or 0)
	if spread <= 0 then
		return desiredDir
	end
	local compensated = desiredDir
	for _ = 1, 6 do
		local spreadOut = okValue(combat.SpreadDir, compensated, spread, seed, 0)
		if typeof(spreadOut) ~= "Vector3" then
			break
