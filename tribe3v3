	if util then
		if type(util.IsTeammate) == "function" then
			local ok, teammate = pcall(util.IsTeammate, model)
			if ok and teammate then
				return "ally"
			end
		end
		if type(util.IsEnemy) == "function" then
			local ok, enemy = pcall(util.IsEnemy, model)
			if ok and enemy then
				return "enemy"
			end
		end
	end
	local own = character()
	local mine = own and Players:GetPlayerFromCharacter(own)
	local theirs = Players:GetPlayerFromCharacter(model)
	if mine and theirs and mine.Team and theirs.Team then
		return mine.Team == theirs.Team and "ally" or "enemy"
	end
	local ownerA = U.attr(model, "OwnerUserId") or U.attr(model, "UserId")
	if theirs == nil and ownerA == nil then
		return "enemy"
	end
	return "enemy"
end
function Targets.hittable(model)
	return model ~= nil and model ~= character() and isAlive(model)
end
function Targets.list()
	local seen = {}
	local out = {}
	local function add(model)
		if typeof(model) == "Instance" and model:IsA("Model") and not seen[model] then
			seen[model] = true
			table.insert(out, model)
		end
	end
	for _, player in Players:GetPlayers() do
		if player ~= LocalPlayer and player.Character then
			add(player.Character)
		end
	end
	for _, tag in { "Combatant", "Bot", "TrainingDummy" } do
		local ok, tagged = pcall(CollectionService.GetTagged, CollectionService, tag)
		if ok and type(tagged) == "table" then
			for _, inst in tagged do
				add(modelOf(inst) or inst)
			end
		end
	end
	return out
end

local Sight = {}
function Sight.params(skip)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = { camera() }
	local own = character()
	if own then
		table.insert(list, own)
	end
	local fx = Workspace:FindFirstChild("FX")
	if fx then
		table.insert(list, fx)
	end
	local projectiles = Workspace:FindFirstChild("Projectiles")
	if projectiles then
		table.insert(list, projectiles)
	end
	for _, model in Targets.list() do
		if Targets.relation(model) == "ally" and model ~= skip then
			table.insert(list, model)
		end
	end
	params.FilterDescendantsInstances = list
	return params
end
function Sight.cast(origin, direction, skip)
	local ok, result = pcall(Workspace.Raycast, Workspace, origin, direction, Sight.params(skip))
	if ok then
		return result
	end
	return nil
end
function Sight.clear(origin, target, model)
	local delta = target - origin
	local dist = delta.Magnitude
	if dist < 0.1 then
		return true
	end
	local hit = Sight.cast(origin, delta, model)
	if not hit then
		return true
	end
	return hit.Instance:IsDescendantOf(model)
end
function Sight.arcClear(origin, target, model, speed, gravity)
	if not speed or speed <= 0 or not gravity or gravity <= 0 then
		return Sight.clear(origin, target, model)
	end
	local delta = target - origin
	local flat = delta * K.Flat
	local dist = flat.Magnitude
	local time = dist / speed
	if time <= 0 then
		return Sight.clear(origin, target, model)
	end
	local vy = (delta.Y + 0.5 * gravity * time * time) / time
	local steps = math.clamp(math.floor(dist / 6), 4, 48)
	local prev = origin
	for i = 1, steps do
		local t = (i / steps) * time
		local point = origin + flat.Unit * (speed * t) + Vector3.new(0, vy * t - 0.5 * gravity * t * t, 0)
		local hit = Sight.cast(prev, point - prev, model)
		if hit and not hit.Instance:IsDescendantOf(model) then
			return false
		end
		prev = point
	end
	return true
end

