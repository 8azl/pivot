	end
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local view = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.05 or view.Magnitude < 0.05 then
		return true
	end
	return flat.Unit:Dot(view.Unit) >= math.cos(math.rad(arcDeg))
