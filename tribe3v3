local function neutralizeGuards()
	local inputStats = mod("InputStats")
	if inputStats then
		syncInputStatsWatches()
		overwriteGuardFn("InputStats", inputStats, "Take", function()
			return 0
		end)
		for _, key in { "Caller", "Note", "Watch", "Start" } do
			overwriteGuardFn("InputStats", inputStats, key, function()
				return nil
			end)
		end
		syncInputStatsWatches()
	end
	local simulation = mod("Simulation")
	if simulation and type(simulation.OnForeignWrite) == "function" then
		pcall(simulation.OnForeignWrite, nil)
		overwriteGuardFn("Simulation", simulation, "OnForeignWrite", function()
			return nil
		end)
	end
	local writeGuard = mod("WriteGuard")
	if writeGuard then
		for _, key in { "Start", "Reset" } do
			overwriteGuardFn("WriteGuard", writeGuard, key, function()
				return nil
			end)
		end
		overwriteGuardFn("WriteGuard", writeGuard, "Stats", function()
			return { cframe = 0, velocity = 0, walkSpeed = 0, jumpHeight = 0, attrs = 0 }
		end)
	end
	local animGuard = mod("AnimGuard")
	if animGuard then
		for _, key in { "Watch", "Check" } do
			overwriteGuardFn("AnimGuard", animGuard, key, function()
				return nil
			end)
		end
	end
	return inputStats ~= nil and simulation ~= nil and writeGuard ~= nil and animGuard ~= nil
end
