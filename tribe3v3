local function stepSession(now)
	local own = character()
	local key = own and U.attr(own, "MatchId")
	key = (type(key) == "string" and key ~= "") and key or false
	if op.matchKey == nil then
		op.matchKey = key
	elseif op.matchKey ~= key then
		op.matchKey = key
		resetSession()
	end
	if now >= op.pruneAt then
		op.pruneAt = now + 2
		for model, entry in op.velocities do
			if not (model.Parent and entry.root and entry.root.Parent) then
				op.velocities[model] = nil
			end
		end
	end
end
