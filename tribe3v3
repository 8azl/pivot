local moduleCache = {}
local moduleRetry = {}
local function mod(name)
	local cached = moduleCache[name]
	if cached then
		return cached
	end
	if os.clock() < (moduleRetry[name] or 0) then
		return nil
	end
	local entry = MODULES[name]
	if not entry then
		return nil
	end
	local node = entry[1]
	for part in entry[2]:gmatch("[^%.]+") do
		node = node and node:FindFirstChild(part)
	end
	if not node and name == "InputStats" and PlayerScripts then
		node = PlayerScripts:FindFirstChild("InputStats", true)
	end
	local ok, result = pcall(require, node)
	if ok and type(result) == "table" then
		moduleCache[name] = result
		return result
	end
	moduleRetry[name] = os.clock() + 2
	return nil
end
