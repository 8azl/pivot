local function hook(moduleName, key, build)
	local target = mod(moduleName)
	if not target or type(target[key]) ~= "function" then
		return false
	end
	local id = moduleName .. "." .. key
	if Shared.Holders[id] then
		if type(restorefunction) == "function" then
			pcall(restorefunction, target[key])
		end
		Shared.Holders[id] = nil
	end
	local original = Shared.Originals[id] or target[key]
	Shared.Originals[id] = original
	local replacement = build(original)
	target[key] = if type(newcclosure) == "function" then newcclosure(replacement) else replacement
	table.insert(Pivot.Restore, function()
		target[key] = original
	end)
	return true
end
