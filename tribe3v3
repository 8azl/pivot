local function rejoin()
	local ts = TeleportService
	pcall(function()
		ts:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
	end)
end
local function serverHop()
	local ts = TeleportService
	local ok, body = pcall(function()
		return game:HttpGet(string.format(K.ServerList, game.PlaceId))
	end)
	if not ok then
		return
	end
	local okJson, data = pcall(function()
		return HttpService:JSONDecode(body)
	end)
	if not okJson or type(data) ~= "table" or type(data.data) ~= "table" then
		return
	end
	local options = {}
	for _, server in data.data do
		if
			type(server) == "table"
			and server.id ~= game.JobId
			and (server.playing or 0) < (server.maxPlayers or 99)
		then
			table.insert(options, server.id)
		end
	end
	if #options > 0 then
		pcall(function()
			ts:TeleportToPlaceInstance(game.PlaceId, options[math.random(1, #options)], LocalPlayer)
		end)
	end
end
