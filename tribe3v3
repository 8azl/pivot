local VALID_CALLER_MT = {
	__index = function()
		return true
	end,
}
local function syncInputStatsWatches()
	local inputStats = mod("InputStats")
	if not inputStats then
		return
	end
	local getups = (type(debug) == "table" and type(debug.getupvalues) == "function" and debug.getupvalues)
		or (type(getupvalues) == "function" and getupvalues)
	local setup = (type(debug) == "table" and type(debug.setupvalue) == "function" and debug.setupvalue)
		or (type(setupvalue) == "function" and setupvalue)
	if type(getups) ~= "function" then
		return
	end
	for _, key in { "Take", "Watch", "Caller" } do
		local fn = Shared.Originals["guard:InputStats." .. key] or inputStats[key]
		if type(fn) == "function" then
			local ok, ups = pcall(getups, fn)
			if ok and type(ups) == "table" then
				for idx, uv in ups do
					if type(uv) == "number" and type(setup) == "function" then
						pcall(setup, fn, idx, 0)
					elseif type(uv) == "table" and uv ~= inputStats and uv.BodyVelocity == nil then
						if #uv == 1 and type(uv[1]) == "number" then
							uv[1] = 0
						elseif type(uv[1]) == "table" and uv[1].t ~= nil and uv[1].k ~= nil then
							for _, item in uv do
								if type(item) == "table" and type(item.t) == "table" and item.k ~= nil then
									item.f = rawget(item.t, item.k)
								end
							end
						elseif key == "Caller" and uv[1] == nil then
							pcall(setmetatable, uv, VALID_CALLER_MT)
						end
					end
				end
			end
		end
	end
end
local function persistentSet(moduleName, key, fn)
	local target = mod(moduleName)
	if not target or type(target[key]) ~= "function" then
		return false
	end
	local id = "guard:" .. moduleName .. "." .. key
	if Shared.Originals[id] == nil then
		Shared.Originals[id] = target[key]
	end
	target[key] = type(newcclosure) == "function" and newcclosure(fn) or fn
	return true
end
local function neutralizeGuards()
	local inputStats = mod("InputStats")
	if inputStats then
		syncInputStatsWatches()
		persistentSet("InputStats", "Take", function()
			return 0
		end)
		for _, key in { "Caller", "Note", "Watch", "Start" } do
			persistentSet("InputStats", key, function()
				return nil
			end)
		end
		syncInputStatsWatches()
	end
	local simulation = mod("Simulation")
	if simulation and type(simulation.OnForeignWrite) == "function" then
		pcall(simulation.OnForeignWrite, nil)
		persistentSet("Simulation", "OnForeignWrite", function()
			return nil
		end)
	end
	local animGuard = mod("AnimGuard")
	if animGuard and type(animGuard.Watch) == "function" then
		persistentSet("AnimGuard", "Watch", function()
			return nil
		end)
	end
	if inputStats then
		Shared.GuardsDone = true
	end
	return inputStats ~= nil
end

