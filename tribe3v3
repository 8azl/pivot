	local kind = handler.ctx and handler.ctx.kind
	if
		kind == "Blunderbuss"
		or kind == "Crossbow"
		or type(combat.SpreadDir) ~= "function"
		or type(handler.Seed) ~= "function"
	then
		return desiredDir
