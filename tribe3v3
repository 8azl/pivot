local Parry = { ids = nil, watch = {}, animators = {}, pendingUntil = 0, lowerAt = 0, nextScan = 0 }
local SWING_PATTERNS = { "_Slash", "_Heavy", "_Dash", "_Stab", "_Swing", "_Lunge", "^Punch_" }
local function swingAnimationIds()
	if Parry.ids then
		return Parry.ids
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Animations")
	if not folder then
		return nil
	end
	local presentation = mod("Presentation")
	local ids = {}
	for _, animation in folder:GetChildren() do
		if animation:IsA("Animation") then
			local name = animation.Name
			local matched = false
			for _, pattern in SWING_PATTERNS do
				if name:find(pattern) then
					matched = true
					break
				end
			end
			if matched and not name:find("Hold") and not name:find("Draw") and not name:find("Parry") then
				local id = animation.AnimationId:match("%d+")
				if id then
					local kind = name:match("^([^_]+)_")
					local preset = presentation and kind and okValue(presentation.For, nil, kind)
					local hitDelay = type(preset) == "table" and tonumber(preset.hitDelay) or 0.08
					ids[id] = { name = name, hitDelay = hitDelay, heavy = name:find("_Heavy") ~= nil }
				end
			end
		end
	end
	Parry.ids = ids
	return ids
