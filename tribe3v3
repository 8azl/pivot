function installRemoteBackstop()
	if
		type(checkcaller) ~= "function"
		or type(hookmetamethod) ~= "function"
		or type(getnamecallmethod) ~= "function"
		or type(newcclosure) ~= "function"
	then
		return false
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local weaponAction = remotes and remotes:FindFirstChild("WeaponAction")
	if not (weaponAction and weaponAction:IsA("RemoteEvent")) then
		return false
	end
	Shared.WeaponAction = weaponAction
	Shared.AnimRelay = remotes:FindFirstChild("AnimRelay")
	Shared.AnalyticsReport = remotes:FindFirstChild("AnalyticsReport")
	Shared.ProfileAction = remotes:FindFirstChild("ProfileAction")
	Shared.Backstop = function(self, action, payload)
		if self ~= Shared.WeaponAction or not Pivot.Running or type(payload) ~= "table" then
			return
		end
		if action == "Shoot" and Settings.FullCharge and type(payload.charge) == "number" then
			payload.charge = 1
		end
		if action == "Swing" and (Settings.MeleeAura or Settings.AutoSwing) then
			if type(payload.hits) == "table" and payload.hits[1] then
				local theirRoot = rootOf(payload.hits[1])
				local myRoot = rootOf(character())
				if theirRoot and myRoot then
					local flat = (theirRoot.Position - myRoot.Position) * Vector3.new(1, 0, 1)
					if flat.Magnitude > 0.05 then
						payload.dir = flat.Unit
					end
				end
			end
			if typeof(payload.dir) == "Vector3" then
				payload.q = Core.dirChecksum(payload.dir)
			end
			return
		end
		if Settings.SilentAim and Settings.RemoteBackstop and typeof(payload.origin) == "Vector3" then
			local shot = op.shot
			if shot and typeof(shot.silentDir) == "Vector3" then
				Core.shotPayload(action, payload, shot.silentDir)
				return
			end
			if action == "Shoot" or action == "Hurl" then
				local handler = op.handler
				if handler and handler.tuning then
					local kind = handler.ctx and handler.ctx.kind
					local tuning = if action == "Hurl" then handler.tuning.throw else handler.tuning
					local state = {
						kind = if action == "Hurl" then "Hatchets" else kind,
						tuning = tuning,
						charge = if Settings.FullCharge then 1 else (tonumber(payload.charge) or 1),
						shotId = tonumber(payload.id),
						gun = action == "Shoot" and Ballistics.isGun(kind),
						handler = handler,
					}
					local previous = op.shot
					op.shot = state
					local ok, direction = pcall(silentDirection, payload.origin)
					op.shot = previous
					if ok and typeof(direction) == "Vector3" then
						Core.shotPayload(action, payload, direction)
					end
				end
			end
		end
		if typeof(payload.dir) == "Vector3" then
			payload.q = Core.dirChecksum(payload.dir)
		end
	end
	if Shared.NamecallInstalled then
		return true
	end
	Shared.NamecallInstalled = true
	local oldNamecall
	oldNamecall = hookmetamethod(
		game,
		"__namecall",
		newcclosure(function(self, ...)
			if not checkcaller() then
				local method = getnamecallmethod()
				if method == "FireServer" then
					if self == Shared.WeaponAction then
						if Pivot.Running then
							local action, payload = select(1, ...), select(2, ...)
							if action == "Charge" and type(payload) == "table" then
								if payload.on == true then
									local pre = op.preCharge
									if
										Settings.FullCharge
										and pre
										and not pre.sending
										and pre.tool == payload.tool
										and pre.kind == payload.kind
										and os.clock() - pre.at < 8
									then
										return nil
									end
									op.preCharge = {
										tool = payload.tool,
										kind = payload.kind,
										at = os.clock(),
										sending = false,
									}
								else
									op.preCharge = nil
								end
							elseif action == "Shoot" then
								op.preCharge = nil
							end
						end
						local backstop = Shared.Backstop
						if backstop then
							pcall(backstop, self, ...)
						end
					elseif self == Shared.AnimRelay or (typeof(self) == "Instance" and self.Name == "AnimRelay") then
						if select("#", ...) >= 6 and select(6, ...) ~= 0 then
							local a1, a2, a3, a4, a5 = ...
							return oldNamecall(self, a1, a2, a3, a4, a5, 0)
						end
					elseif
						self == Shared.AnalyticsReport
						or (typeof(self) == "Instance" and self.Name == "AnalyticsReport")
					then
						if select("#", ...) >= 3 and select(1, ...) == "Fps" and select(3, ...) ~= 0 then
							local a1, a2 = ...
							return oldNamecall(self, a1, a2, 0)
						end
					end
				elseif method == "InvokeServer" then
					if
						self == Shared.ProfileAction
						or (typeof(self) == "Instance" and self.Name == "ProfileAction")
					then
						if select("#", ...) >= 3 and select(1, ...) == "AckReveal" and select(3, ...) ~= 0 then
							local a1, a2 = ...
							return oldNamecall(self, a1, a2, 0)
						end
					end
				end
			end
			return oldNamecall(self, ...)
		end)
	)
	return true
end
