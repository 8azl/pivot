	local best, bestScore
	for _, model in Targets.list() do
		if Targets.relation(model) == "enemy" and Targets.hittable(model) then
			local tr = rootOf(model)
			if tr then
				local score
				if Config.TeleportTarget == "Lowest HP" then
					local hum = humanoidOf(model)
					score = hum and hum.Health or math.huge
				else
					score = (tr.Position - root.Position).Magnitude
				end
				if not bestScore or score < bestScore then
					bestScore = score
					best = model
				end
			end
		end
	end
	return best
end

local function cameraAim(dt)
	if not (Pivot.Running and Config.Aimbot and aimKeyDown()) then
		return
	end
	local cam = camera()
	local own = character()
	if not (cam and own and isAlive(own)) then
		return
	end
	local origin = cam.CFrame.Position
	local model, part = pickEnemy(origin, Config.VisibleCheck)
	if not (model and part) then
		return
	end
	local aimPoint = part.Position
	local kind = currentKind()
	if isRanged(kind) and op.handler and op.handler.tuning then
		local speed, gravity = Ballistics.profile(kind, op.handler.tuning, handlerCharge(op.handler))
		aimPoint = Ballistics.intercept(origin, model, part, speed, gravity)
	end
	if Config.AimHumanize then
		local jitter = 0.4
		aimPoint = aimPoint
			+ Vector3.new(
				(math.random() - 0.5) * jitter,
				(math.random() - 0.5) * jitter,
				(math.random() - 0.5) * jitter
			)
	end
	local targetCF = CFrame.lookAt(origin, aimPoint)
	local alpha = math.clamp(1 - Config.AimSmoothness / 100, 0.02, 1)
	cam.CFrame = cam.CFrame:Lerp(targetCF, alpha)
end

