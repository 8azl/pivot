function op.guard(name, fn, ...)
	local packed = table.pack(xpcall(fn, function(message)
		return debug.traceback(tostring(message), 2)
	end, ...))
	if packed[1] then
		return table.unpack(packed, 1, packed.n)
	end
	local errors = Shared.Errors
	if type(errors) ~= "table" then
		errors = {}
		Shared.Errors = errors
	end
	local previous = errors[name]
	errors[name] = { message = tostring(packed[2]), at = tick(), count = (previous and previous.count or 0) + 1 }
	return false
end

