	local tool = handler.ctx and handler.ctx.tool
	if not (tool and tool.Parent) then
		return false
	end
	if handler.reloading or U.attr(tool, "Reloading") == true then
		return false
	end
	if type(handler.OutOfAmmo) == "function" then
		local ok, empty = pcall(handler.OutOfAmmo, handler)
		if ok and empty then
			return false
		end
	end
	if type(handler.ammo) == "number" and handler.ammo <= 0 then
		return false
	end
	local wait = nil
	if handler.tuning then
		wait = handler.tuning.fireInterval or handler.nextCd or handler.tuning.cooldown
	else
		wait = handler.nextCd
	end
	if type(handler.lastShot) == "number" and type(wait) == "number" and os.clock() - handler.lastShot < wait then
		return false
	end
	if not canAct() then
		return false
	end
	local util = mod("Util")
	if util and type(util.IsMouseUnlocked) == "function" then
		local ok, unlocked = pcall(util.IsMouseUnlocked)
		if ok and unlocked then
			return false
		end
	end
	if util and type(util.GuardRecovery) == "function" then
		local ok, recover = pcall(util.GuardRecovery, tool)
		if ok and type(recover) == "number" and recover > 0 then
