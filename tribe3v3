end
local function rootOf(model)
	if typeof(model) ~= "Instance" then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	return (root and root:IsA("BasePart")) and root or nil
end
local function humanoidOf(model)
	return (typeof(model) == "Instance" and model:FindFirstChildOfClass("Humanoid")) or nil
end
local function isAlive(model)
	local humanoid = humanoidOf(model)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	if U.attr(model, "Alive") == false then
		return false
	end
	local player = Players:GetPlayerFromCharacter(model)
	if player and U.attr(player, "Alive") == false then
		return false
	end
	if humanoid.PlatformStand == true then
		return false
	end
	local ok, state = pcall(humanoid.GetState, humanoid)
	if ok
		and (
			state == Enum.HumanoidStateType.Dead
			or state == Enum.HumanoidStateType.Physics
			or state == Enum.HumanoidStateType.Ragdoll
			or state == Enum.HumanoidStateType.FallingDown
		)
	then
		return false
	end
	return true
end
local function modelOf(instance)
	if typeof(instance) ~= "Instance" then
		return nil
	end
	if instance:IsA("Player") then
		return instance.Character
	end
	return instance:IsA("Model") and instance or nil
end
