	Teleport.home = Teleport.home or myRoot.CFrame
	local goal = Core.behind(theirRoot.CFrame, math.clamp(Settings.TeleportOffset, 1.5, 6))
	model:PivotTo(
		CFrame.lookAt(goal.Position, Vector3.new(theirRoot.Position.X, goal.Position.Y, theirRoot.Position.Z))
