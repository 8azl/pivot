		return nil, nil
	end
	local viewport = camera.ViewportSize
	local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
	local eye = origin or camera.CFrame.Position
	local bestModel, bestPart, bestScore = nil, nil, math.huge
	for _, model in Targets.list() do
		if Targets.hittable(model) and Targets.relation(model) ~= "ally" then
			local part = Targets.aimPart(model, eye)
			local humanoid = humanoidOf(model)
			if part and humanoid then
				local screen, visibleOnScreen = camera:WorldToViewportPoint(part.Position)
				if visibleOnScreen then
					local offset = (Vector2.new(screen.X, screen.Y) - center).Magnitude
					if offset <= Settings.AimFov then
