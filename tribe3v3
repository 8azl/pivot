local hitboxOriginal = {}
local function restoreHitbox(part)
	local saved = hitboxOriginal[part]
	if not saved then
		return
	end
	hitboxOriginal[part] = nil
	pcall(function()
		if part and part.Parent then
			part.Size = saved.size
			part.CanCollide = saved.canCollide
			part.Transparency = saved.transparency
		end
	end)
end
local function restoreHitboxes()
	for part in hitboxOriginal do
		restoreHitbox(part)
	end
end
local function stepHitbox(now)
	if not Config.HitboxExpander then
		restoreHitboxes()
		return
	end
	local size = Config.HitboxSize
	local wanted = {}
	for _, model in Targets.list() do
		if Targets.relation(model) == "enemy" and Targets.hittable(model) then
			local root = rootOf(model)
			if root then
				wanted[root] = true
				if not hitboxOriginal[root] then
					hitboxOriginal[root] =
						{ size = root.Size, canCollide = root.CanCollide, transparency = root.Transparency }
				end
				pcall(function()
					root.Size = Vector3.new(size, size, size)
					root.CanCollide = false
				end)
			end
		end
	end
	for part in hitboxOriginal do
		if not wanted[part] then
			restoreHitbox(part)
		end
	end
end

local function stepTeleportKill(now)
