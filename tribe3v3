local function installRemoteBackstop()
	if
		type(checkcaller) ~= "function"
		or type(hookmetamethod) ~= "function"
		or type(getnamecallmethod) ~= "function"
		or type(newcclosure) ~= "function"
	then
		return false
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local weaponAction = remotes and remotes:FindFirstChild("WeaponAction")
	if not (weaponAction and weaponAction:IsA("RemoteEvent")) then
		return false
	end
	Shared.WeaponAction = weaponAction
	Shared.AnimRelay = remotes:FindFirstChild("AnimRelay")
	Shared.AnalyticsReport = remotes:FindFirstChild("AnalyticsReport")
	Shared.ProfileAction = remotes:FindFirstChild("ProfileAction")
	Shared.ChargeFilter = function(action, payload)
		if action == "Charge" and type(payload) == "table" then
			if payload.on == true then
				local pre = op.preCharge
				if
					Config.FullCharge
					and pre
					and pre.tool == payload.tool
					and pre.kind == payload.kind
					and tick() - pre.at < 8
				then
					return true
				end
				op.preCharge = { tool = payload.tool, kind = payload.kind, at = tick() }
			else
				op.preCharge = nil
			end
		elseif action == "Shoot" then
			op.preCharge = nil
		end
		return false
	end
	Shared.Backstop = function(self, action, payload)
		if self ~= Shared.WeaponAction or type(payload) ~= "table" then
			return
		end
		if action == "Shoot" and Config.FullCharge and type(payload.charge) == "number" then
			payload.charge = 1
		end
		if
			action == "Swing"
			and (Config.MeleeAura or Config.AutoSwing)
			and type(payload.hits) == "table"
			and payload.hits[1]
		then
			local theirRoot = rootOf(modelOf(payload.hits[1]) or payload.hits[1])
			local myRoot = rootOf(character())
			if theirRoot and myRoot then
				local flat = (theirRoot.Position - myRoot.Position) * K.Flat
				if flat.Magnitude > 0.05 then
					payload.dir = flat.Unit
				end
			end
		end
		if
			Config.SilentAim
			and Config.RemoteBackstop
			and typeof(payload.origin) == "Vector3"
			and (action == "Shoot" or action == "Hurl")
		then
			local shot = op.shot
			local direction = shot and shot.silentDir
			if typeof(direction) ~= "Vector3" then
				local state = activeHandlerState(action, payload)
				if state then
					direction = within(state, silentDirection, payload.origin)
				end
			end
			if typeof(direction) == "Vector3" then
				Core.shotPayload(action, payload, direction)
			end
		end
		if typeof(payload.dir) == "Vector3" then
			payload.q = Core.dirChecksum(payload.dir)
		end
	end
	if Shared.NamecallInstalled then
		return true
	end
	Shared.NamecallInstalled = true
	local oldNamecall
	oldNamecall = hookmetamethod(
		game,
		"__namecall",
		newcclosure(function(self, ...)
			if not checkcaller() then
				local method = getnamecallmethod()
				if method == "FireServer" and self == Shared.WeaponAction and Shared.Backstop then
					local action = select(1, ...)
					local payload = select(2, ...)
					local filter = Shared.ChargeFilter
					if filter and (action == "Charge" or action == "Shoot") then
						local ok, drop = pcall(filter, action, payload)
						if ok and drop then
							return nil
						end
					end
					pcall(Shared.Backstop, self, action, payload)
				elseif method == "FireServer" and Shared.Backstop then
					if self == Shared.AnimRelay and select("#", ...) >= 6 and select(6, ...) ~= 0 then
						local a1, a2, a3, a4, a5 = ...
						return oldNamecall(self, a1, a2, a3, a4, a5, 0)
					elseif
						self == Shared.AnalyticsReport
						and select("#", ...) >= 3
						and select(1, ...) == "Fps"
						and select(3, ...) ~= 0
					then
						local a1, a2 = ...
						return oldNamecall(self, a1, a2, 0)
					end
				elseif method == "InvokeServer" and Shared.Backstop and self == Shared.ProfileAction then
					if select("#", ...) >= 3 and select(1, ...) == "AckReveal" and select(3, ...) ~= 0 then
						local a1, a2 = ...
						return oldNamecall(self, a1, a2, 0)
					end
				end
			end
			return oldNamecall(self, ...)
		end)
	)
	return true
end

