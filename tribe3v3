	if kind == "Projectile" then
		if not enemyRoot(data.shooter) then
			return
		end
		if typeof(data.origin) ~= "Vector3" or typeof(data.velocity) ~= "Vector3" then
			return
		end
		local gravity = tonumber(data.gravity) or 0
		local target = root.Position
		for frame = 1, 90 do
			local t = frame / 60
			local point = data.origin + data.velocity * t - Vector3.new(0, 0.5 * gravity * t * t, 0)
