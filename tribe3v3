			result = hit
		end
	end
	if not result then
		local ray
		local originalRay = Shared.Originals and Shared.Originals["Util.GetAimRay"]
		if type(originalRay) == "function" then
			local ok, value = pcall(originalRay)
			if ok and typeof(value) == "Ray" then
				ray = value
			end
		end
		if not ray and util and type(util.GetAimRay) == "function" then
			local ok, value = pcall(util.GetAimRay)
			if ok and typeof(value) == "Ray" then
				ray = value
			end
		end
		if typeof(ray) ~= "Ray" then
			local cam = camera()
			if not cam then
				return nil
			end
			local view = cam.ViewportSize
			ray = cam:ViewportPointToRay(view.X / 2, view.Y / 2)
		end
		local params
		if util and type(util.WorldParams) == "function" then
			local extra
			if type(util.Teammates) == "function" then
				local ok, mates = pcall(util.Teammates)
				if ok then
					extra = mates
				end
			end
			local ok, value = pcall(util.WorldParams, extra)
			if ok then
				params = value
			end
		end
		local ok, hit = pcall(Workspace.Raycast, Workspace, ray.Origin, ray.Direction.Unit * 2000, params or Sight.params(nil))
		if ok then
			result = hit
		end
	end
	if not (result and result.Instance) then
		return nil
	end
	local model
	if combat and type(combat.FindCharacter) == "function" then
		local ok, found = pcall(combat.FindCharacter, result.Instance)
		if ok then
			model = found
		end
	end
	if typeof(model) ~= "Instance" then
		model = result.Instance:FindFirstAncestorOfClass("Model")
	end
	if not model or Targets.relation(model) ~= "enemy" or not Targets.hittable(model) then
		return nil
	end
	if not isAllowedHitPart(result.Instance, model) then
		return nil
	end
	local point = result.Position
	local origin
	if util and type(util.ShotOrigin) == "function" and op.handler and op.handler.ctx then
		local ok, value = pcall(util.ShotOrigin, op.handler.ctx.tool, "Muzzle")
		if ok and typeof(value) == "Vector3" then
			origin = value
		end
	end
	if typeof(origin) ~= "Vector3" then
		local cam = camera()
		origin = cam and cam.CFrame.Position or nil
	end
	if typeof(origin) == "Vector3" then
		if combat and type(combat.SmokeBlocks) == "function" then
			local ok, blocked = pcall(combat.SmokeBlocks, origin, point)
			if ok and blocked then
				return nil
			end
		end
		if util and type(util.WorldParams) == "function" and type(util.Targets) == "function" then
			local okTargets, targets = pcall(util.Targets)
			local okParams, params = pcall(util.WorldParams, okTargets and targets or nil)
			if okParams and params then
				local delta = point - origin
				local dist = delta.Magnitude
				if dist > 0.15 then
					local okHit, wall = pcall(Workspace.Raycast, Workspace, origin, delta.Unit * (dist - 0.1), params)
					if okHit and wall then
						return nil
					end
				end
			end
		elseif not Sight.clear(origin, point, model) then
			return nil
		end
	end
	return model, result.Instance
end
local function stepTrigger(now)
	if not Config.Triggerbot then
		releaseTriggerHold()
		op.triggerModel = nil
		op.triggerAt = 0
		op.triggerWait = 0
		return
	end
	local own = character()
	if not (own and isAlive(own) and canAct()) then
		releaseTriggerHold()
		return
	end
	if not triggerReady(op.handler) then
		if op.triggerHeld and not (op.handler and op.handler.drawing) then
			releaseTriggerHold()
		end
		if not (op.handler and isRanged(currentKind())) then
			releaseTriggerHold()
			op.triggerModel = nil
			op.triggerAt = 0
			op.triggerWait = 0
		end
		return
	end
	if U.mouseHeld(Enum.UserInputType.MouseButton1) and not op.triggerHeld then
		return
	end
	local model = peekTarget()
	if not model then
		releaseTriggerHold()
		op.triggerModel = nil
		op.triggerAt = 0
		op.triggerWait = 0
		return
	end
	if op.triggerModel ~= model then
		op.triggerModel = model
		op.triggerAt = now
		op.triggerWait = rollTriggerDelay()
		return
	end
	if not Core.reacted(op.triggerAt, now, op.triggerWait) then
		return
	end
	local kind = currentKind()
	if isRanged(kind) and op.handler and op.handler.tuning and op.handler.tuning.drawTime then
		if not op.triggerHeld then
			if dispatch("Primary", true) then
				op.triggerHeld = true
				op.triggerChargeAt = now
			end
		elseif
			handlerCharge(op.handler) >= Config.ReleaseCharge / 100
			or (now - (op.triggerChargeAt or now)) > 0.55 + math.random() * 0.2
		then
			releaseTriggerHold()
			op.triggerModel = nil
			op.triggerAt = 0
			op.triggerWait = 0
		end
	else
		if not op.triggerHeld then
			if dispatch("Primary", true) then
				op.triggerHeld = true
				op.triggerReleaseAt = now + 0.04 + math.random() * 0.07
			end
		elseif now >= (op.triggerReleaseAt or now) then
			releaseTriggerHold()
			op.triggerAt = now
			op.triggerWait = rollTriggerDelay()
		end
	end
end

