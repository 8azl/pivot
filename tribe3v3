		queueLoader()
	end
end)

local function unload()
	Pivot.Running = false
	for key, value in Config do
		if type(value) == "boolean" then
			Config[key] = false
		end
	end
	releaseTrigger()
	releaseBlock()
	hideAllVisuals()
	restoreHitboxes()
	if op.bobApplied then
		local cam = mod("Camera")
		if cam and type(cam.SetViewBobbing) == "function" then
			pcall(cam.SetViewBobbing, true)
		end
		op.bobApplied = false
	end
	if Config.TeleportReturn and op.tpHome then
		local root = rootOf(character())
		if root then
			pcall(function()
				root.CFrame = op.tpHome
			end)
		end
	end
	op.tpHome = nil
	Shared.Backstop = nil
	Shared.ChargeFilter = nil
	op.shot, op.meleeDirection, op.handler, op.heal = nil, nil, nil, nil
	table.clear(op.velocities)
	for _, restore in Pivot.Restore do
		pcall(restore)
	end
	table.clear(Pivot.Restore)
	for _, conn in Pivot.Connections do
		pcall(function()
			conn:Disconnect()
		end)
	end
	table.clear(Pivot.Connections)
	for _, obj in Pivot.Drawings do
		pcall(function()
			obj:Remove()
		end)
	end
	table.clear(Pivot.Drawings)
	for _, entry in chamEntries do
		pcall(function()
			entry.highlight:Destroy()
		end)
	end
	table.clear(chamEntries)
	table.clear(espSlots)
	table.clear(tracerSlots)
	table.clear(trapSlots)
	table.clear(skeletonSlots)
	fovCircle = nil
	hitMarker = nil
	if window then
		if window._ui then
			pcall(function()
				window._ui:Destroy()
			end)
		end
		if window._toggle_gui then
			pcall(function()
				window._toggle_gui:Destroy()
			end)
		end
		if type(window.Destroy) == "function" then
			pcall(function()
				window:Destroy()
			end)
		end
	end
	for _, gui in Pivot.Guis do
		pcall(function()
			gui:Destroy()
		end)
	end
	table.clear(Pivot.Guis)
	if getgenv().PivotUnload == unload then
		getgenv().PivotUnload = nil
	end
end
